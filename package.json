{
	"name": "cnsatinder",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:schema": "node supabase/schema.test.mjs",
		"test:chat": "node scripts/chat-logic.test.mjs",
		"test:e2e": "node scripts/realtime-e2e.mjs",
		"test:match": "node scripts/match-stress.mjs",
		"test:admin": "node scripts/admin-session.test.mjs",
		"test:toast": "node --no-warnings --conditions=browser scripts/toast.test.mjs",
		"test:platform": "node --no-warnings scripts/platform.test.mjs"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.3.14",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.135.0"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.110.0"
	}
}
