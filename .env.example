# Supabase Dashboard > Project Settings > API
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# PUBLIC_SUPABASE_ANON_KEY=eyJ...   # 구형 프로젝트는 이쪽

# --- 서버 전용 (클라이언트 번들에 절대 들어가지 않음) ---
# 운영자 대시보드(/admin)에서만 사용. 반드시 PUBLIC_SUPABASE_URL 과 **같은 프로젝트**.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 운영자 세션 쿠키 서명 키 (32자 이상 무작위). 바꾸면 운영진 전원이 로그아웃된다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# 푸시 알림 — node scripts/vapid-keys.mjs 가 .env 에 만들어 준다. 한 번 정하면 바꾸지 말 것(기존 구독 무효).
# Cloudflare 에는 셋 다 Variables and Secrets 로 (VAPID_PRIVATE_KEY 는 Secret).
PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://cnsatinder.mightycha0826.workers.dev
